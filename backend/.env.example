# Copy to backend/.env (gitignored). The server reads this from the backend/ working directory.

# Rho API access token. The SANDBOX accepts any non-empty value, so a placeholder works today.
# Production tokens start with "rhobat_" and are created at https://app.rho.co/settings/access-tokens
RHO_API_KEY=sandbox-any-token
RHO_BASE_URL=https://rhoapi-sandbox.rho.co/api/v1

# Poller. Rho allows ~60 req/min per token; 5s => ~12 req/min, plenty of headroom.
POLL_INTERVAL_SECONDS=5
PAGE_SIZE=100
# On every start, walk the whole feed oldest->newest so the in-memory graph/scorer have a baseline.
# The cursor (STATE_DIR/cursor.json) keeps steady-state polls from re-emitting known rows as live events.
BACKFILL_ON_START=true
# Steady-state ticks use initiated_after so they only ask Rho for genuinely new rows, which
# means a settlement on an older transaction won't surface there. Every Nth tick, separately
# re-check (by id) everything still recorded as pending/awaiting_approval.
PENDING_SWEEP_EVERY_N_TICKS=6

# Scoring: zscore | autoencoder (autoencoder is a stub that falls back to zscore until implemented)
SCORER=zscore
MIN_HISTORY=2
WARN_THRESHOLD=0.5
ALERT_THRESHOLD=0.75

# Vendor verification: a Tavily web search for brand-new vendors on live transactions only.
# Empty = off. It can nudge an existing warn/alert score but never changes the level.
TAVILY_API_KEY=
VENDOR_LOOKUP_TIMEOUT_SECONDS=3

# Demo helpers. The sandbox feed is STATIC (72 rows, nothing new ever arrives), so:
#  - DEMO_REPLAY=true replays the fixture as if live, one row every N seconds (great for frontend dev)
#  - POST /api/demo/inject pushes a hand-crafted transaction through the same pipeline (the pitch demo)
#  - DEMO_OFFLINE=true forces the checked-in fixture even if Rho is reachable, so you can rehearse
#    the "no wifi" path deliberately. The app also falls back to it automatically if Rho is
#    unreachable or RHO_API_KEY is empty -- this just makes that path happen on demand.
DEMO_REPLAY=false
DEMO_REPLAY_INTERVAL_SECONDS=3
DEMO_OFFLINE=false

# Where the poller persists its cursor so restarts don't re-emit everything
STATE_DIR=.state
FIXTURES_DIR=fixtures

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
